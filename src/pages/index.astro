---
import { ExternalLink, FileDown, GitBranch, Mail, Play, Rocket, ShieldCheck } from "lucide-react";
import GlobalInteractions from "../components/GlobalInteractions";
import HeroScene from "../components/HeroScene";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilityGroups, profile, projects, proofSignals, timeline } from "../data/portfolio";

const title = "Phạm Hoàng An | AI/ML Portfolio";
const description =
  "AI/ML portfolio for Phạm Hoàng An, focused on computer vision, YOLO pipelines, keyword spotting, and applied ML systems.";

const signalBand = [
  {
    heading: "ML workflows",
    viHeading: "Workflow ML",
    text: "Training, evaluation, inference, algorithm evidence",
    viText: "Training, evaluation, inference, bằng chứng thuật toán",
  },
  {
    heading: "Computer vision",
    viHeading: "Computer vision",
    text: "Detection, tracking, homography, visual review",
    viText: "Detection, tracking, homography, kiểm tra trực quan",
  },
  {
    heading: "Streaming logic",
    viHeading: "Logic streaming",
    text: "Windowing, thresholds, voting, rejection gates",
    viText: "Windowing, threshold, voting, cổng từ chối",
  },
  {
    heading: "Evidence",
    viHeading: "Bằng chứng",
    text: "Repos, runbooks, metrics, demos",
    viText: "Repo, runbook, metric, demo",
  },
];

const heroSignals = [
  {
    key: "detect",
    label: "YOLO",
    viLabel: "YOLO",
    state: "detect",
    viState: "detect",
    detail: "pose / object",
    viDetail: "pose / object",
    metric: "bbox",
    viMetric: "bbox",
    bars: [62, 84, 70],
  },
  {
    key: "track",
    label: "OpenCV",
    viLabel: "OpenCV",
    state: "track",
    viState: "track",
    detail: "geometry + motion",
    viDetail: "hình học + chuyển động",
    metric: "fps",
    viMetric: "fps",
    bars: [44, 68, 88],
  },
  {
    key: "infer",
    label: "Real-time inference",
    viLabel: "Inference thời gian thực",
    state: "infer",
    viState: "infer",
    detail: "low-latency loop",
    viDetail: "vòng lặp độ trễ thấp",
    metric: "live",
    viMetric: "live",
    bars: [35, 76, 52, 92, 64],
    highlight: true,
  },
  {
    key: "reproduce",
    label: "Reproducible runs",
    viLabel: "Chạy tái lập",
    state: "reproduce",
    viState: "tái lập",
    detail: "runbooks + repos",
    viDetail: "runbook + repo",
    metric: "git",
    viMetric: "git",
    bars: [58, 58, 58],
  },
];

const proofCards = [
  {
    icon: ShieldCheck,
    title: "Repo-backed systems",
    viTitle: "Hệ thống có repo kiểm tra",
    text: "Each selected project links to source code and a concrete implementation path.",
    viText: "Mỗi project chính đều có link source code và hướng triển khai cụ thể.",
  },
  {
    icon: GitBranch,
    title: "Algorithmic clarity",
    viTitle: "Thuật toán rõ ràng",
    text: "Project evidence is presented as pipelines: detect, track, threshold, rank, reject, export.",
    viText: "Bằng chứng project được trình bày theo pipeline: detect, track, threshold, rank, reject, export.",
  },
  {
    icon: FileDown,
    title: "Review package",
    viTitle: "Bộ hồ sơ để review",
    text: "CV, LinkedIn, email, selected repos, and demo links are reachable without friction.",
    viText: "CV, LinkedIn, email, repo chọn lọc và link demo đều dễ truy cập.",
  },
  {
    icon: Play,
    title: "Demo-visible work",
    viTitle: "Dự án có demo để xem",
    text: "The portfolio favors visible outputs: annotated video, streaming flow, webcam labels, and evaluation artifacts.",
    viText: "Portfolio ưu tiên output nhìn được: video annotate, flow streaming, label webcam và artifact đánh giá.",
  },
];
---

<BaseLayout title={title} description={description}>
  <GlobalInteractions client:load />

  <header class="site-header" data-site-header>
    <a class="brand" href="#top" aria-label="Go to top">
      <span class="brand-mark">PA</span>
      <span>{profile.name}</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list" id="site-menu" data-nav-list>
        <li><a href="#work"><span data-copy="en">Work</span><span data-copy="vi">Dự án</span></a></li>
        <li><a href="#stack"><span data-copy="en">Stack</span><span data-copy="vi">Kỹ năng</span></a></li>
        <li><a href="#proof"><span data-copy="en">Proof</span><span data-copy="vi">Bằng chứng</span></a></li>
        <li><a href="#profile"><span data-copy="en">Profile</span><span data-copy="vi">Hồ sơ</span></a></li>
        <li><a href="#contact"><span data-copy="en">Contact</span><span data-copy="vi">Liên hệ</span></a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="language-toggle" type="button" aria-pressed="false" aria-label="Switch to Vietnamese" data-language-toggle>
        <span data-copy="en">VI</span>
        <span data-copy="vi">EN</span>
      </button>
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-label="Open menu"
        aria-controls="site-menu"
        data-menu-button
      >
        <span></span>
        <span></span>
        <span></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="hero-shell" id="top">
      <HeroScene client:idle />
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow" data-intro>
            <span data-copy="en">AI/ML Intern · Computer Vision</span>
            <span data-copy="vi">AI/ML Intern · Computer Vision</span>
          </p>
          <h1 data-intro>
            <span>{profile.name}</span>
            <strong>
              <span data-copy="en">I build ML systems from model to working demo.</span>
              <span data-copy="vi">Tôi xây dựng hệ thống ML từ model đến demo chạy được.</span>
            </strong>
          </h1>
          <p class="hero-text" data-intro>
            <span data-copy="en">
              ICT student at USTH focused on computer vision, real-time inference, and reproducible Python workflows.
              My work connects training, evaluation, demos, and clear documentation.
            </span>
            <span data-copy="vi">
              Sinh viên ICT tại USTH, tập trung computer vision, inference thời gian thực và workflow Python có thể tái lập.
              Tôi kết nối training, evaluation, demo và tài liệu rõ ràng.
            </span>
          </p>

          <div class="hero-actions" aria-label="Primary actions" data-intro>
            <a class="button button-primary" href="#work" data-magnetic>
              <Rocket size={16} aria-hidden="true" />
              <span data-copy="en">View Work</span>
              <span data-copy="vi">Xem dự án</span>
            </a>
            <a class="button button-secondary" href={profile.cv} target="_blank" rel="noreferrer" data-magnetic>
              <FileDown size={16} aria-hidden="true" />
              <span data-copy="en">Download CV</span>
              <span data-copy="vi">Tải CV</span>
            </a>
            <a class="button button-ghost" href={profile.github} target="_blank" rel="me noreferrer" data-magnetic>
              <ExternalLink size={16} aria-hidden="true" />
              GitHub
            </a>
          </div>

          <div class="hero-signals drag-rail" aria-label="Live ML signal strip" data-intro data-signal-strip data-drag-scroll>
            {heroSignals.map((signal, index) => (
              <article
                class:list={["signal-module", signal.highlight && "signal-module-live"]}
                data-signal={signal.key}
                style={`--signal-delay: ${index * 0.12}s;`}
              >
                <span class="signal-scan" aria-hidden="true"></span>
                <div class="signal-module-head">
                  <span class="signal-dot" aria-hidden="true"></span>
                  <strong>
                    <span data-copy="en">{signal.label}</span>
                    <span data-copy="vi">{signal.viLabel}</span>
                  </strong>
                  <em>
                    <span data-copy="en">{signal.state}</span>
                    <span data-copy="vi">{signal.viState}</span>
                  </em>
                </div>
                <p>
                  <span data-copy="en">{signal.detail}</span>
                  <span data-copy="vi">{signal.viDetail}</span>
                </p>
                <div class="signal-module-foot">
                  <span>
                    <span data-copy="en">{signal.metric}</span>
                    <span data-copy="vi">{signal.viMetric}</span>
                  </span>
                  <div class="signal-bars" aria-hidden="true">
                    {signal.bars.map((bar) => <i style={`--bar-level: ${bar}%;`}></i>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <aside class="avatar-command" aria-label="Recruiter snapshot" data-intro>
          <div class="avatar-frame">
            <picture>
              <source type="image/webp" srcset={profile.portrait.webp} sizes="(max-width: 720px) 220px, (max-width: 1080px) 300px, 360px" />
              <img
                src={profile.portrait.fallback}
                width="720"
                height="1111"
                alt={`Portrait of ${profile.name}`}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <div class="avatar-meta">
            <p class="panel-kicker">
              <span data-copy="en">Snapshot</span>
              <span data-copy="vi">Tóm tắt</span>
            </p>
            <h2>{profile.name}</h2>
            <p>
              <span data-copy="en">{profile.role} - {profile.location}</span>
              <span data-copy="vi">{profile.viRole} - {profile.viLocation}</span>
            </p>
          </div>
          <dl class="signal-grid">
            {proofSignals.slice(0, 3).map((signal) => (
              <div class="signal-tile">
                <dt data-count={Number.isNaN(Number.parseInt(signal.value, 10)) ? undefined : signal.value}>{signal.value}</dt>
                <dd><span data-copy="en">{signal.label}</span><span data-copy="vi">{signal.vi}</span></dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class="signal-band drag-rail" aria-label="Verification signals" data-reveal data-drag-scroll>
      {signalBand.map((item) => (
        <article>
          <strong><span data-copy="en">{item.heading}</span><span data-copy="vi">{item.viHeading}</span></strong>
          <span><span data-copy="en">{item.text}</span><span data-copy="vi">{item.viText}</span></span>
        </article>
      ))}
    </section>

    <section class="section work-section" id="work">
      <div class="section-header" data-reveal>
        <p class="eyebrow">
          <span data-copy="en">Selected work</span>
          <span data-copy="vi">Dự án chọn lọc</span>
        </p>
        <h2>
          <span data-copy="en">Case studies built as readable algorithm systems.</span>
          <span data-copy="vi">Case study được trình bày như hệ thống thuật toán dễ đọc.</span>
        </h2>
      </div>

      <div class="project-stack">
        {projects.map((project, index) => (
          <article class={`project-story project-${project.id}`} data-project-id={project.id}>
            <div class="story-index" aria-hidden="true">0{index + 1}</div>
            <div class="story-visual" data-visual-mode={project.visualMode}>
              <div class="visual-dashboard">
                <div class="visual-topbar">
                  <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
                  <strong><span data-copy="en">{project.mediaStatus}</span><span data-copy="vi">{project.viMediaStatus}</span></strong>
                  <span class="visual-mode">{project.visualMode}</span>
                </div>

                {project.id === "pickleball" && (
                  <>
                    <div class="demo-theater">
                      <div
                        class="demo-frame media-fallback"
                        data-demo-frame
                        data-demo-src={project.demoEmbed}
                        data-demo-open={project.demo}
                        data-demo-title={project.demoLabel}
                      >
                        <div class="demo-poster">
                          <span class="poster-play" aria-hidden="true"><Play size={22} /></span>
                          <strong><span data-copy="en">{project.demoLabel}</span><span data-copy="vi">{project.viDemoLabel}</span></strong>
                          <p>
                            <span data-copy="en">Load the Google Drive preview inside this portfolio.</span>
                            <span data-copy="vi">Tải preview Google Drive trực tiếp trong portfolio.</span>
                          </p>
                          <button class="demo-load" type="button" data-demo-load>
                            <Play size={15} aria-hidden="true" />
                            <span data-copy="en">Watch Demo</span>
                            <span data-copy="vi">Xem demo</span>
                          </button>
                          <a href={project.demo} target="_blank" rel="noreferrer">
                            <ExternalLink size={14} aria-hidden="true" />
                            <span data-copy="en">Open in Drive</span>
                            <span data-copy="vi">Mở bằng Drive</span>
                          </a>
                        </div>
                      </div>
                    </div>
                    <div class="visual-pickle visual-pickle-map" aria-hidden="true">
                      <span class="algorithm-kicker">detect.track.project</span>
                      <span class="court-line line-a"></span>
                      <span class="court-line line-b"></span>
                      <span class="court-line line-c"></span>
                      <span class="court-line line-d"></span>
                      <span class="player-dot dot-a"></span>
                      <span class="player-dot dot-b"></span>
                      <span class="ball-path"></span>
                      <span class="heat-zone"></span>
                      <span class="track-vector vector-a"></span>
                      <span class="track-vector vector-b"></span>
                      {Array.from({ length: 12 }, (_, pointIndex) => (
                        <span class={`court-point point-${pointIndex + 1}`}></span>
                      ))}
                      <span class="algorithm-readout readout-a">homography</span>
                      <span class="algorithm-readout readout-b">kalman</span>
                    </div>
                    <dl class="visual-metrics">
                      <div><dt>12</dt><dd>court keypoints</dd></div>
                      <div><dt>4x</dt><dd>tracking cascade</dd></div>
                      <div><dt>2D</dt><dd>court projection</dd></div>
                    </dl>
                  </>
                )}

                {project.id === "kws" && (
                  <>
                    <div class="visual-audio visual-audio-lab" aria-hidden="true">
                      <span class="algorithm-kicker">stream.segment.reject</span>
                      <span class="audio-window window-a"></span>
                      <span class="audio-window window-b"></span>
                      <span class="audio-window window-c"></span>
                      <span class="wave-bar"></span><span class="wave-bar"></span><span class="wave-bar"></span><span class="wave-bar"></span><span class="wave-bar"></span><span class="wave-bar"></span>
                      <span class="spectrogram spectro-a"></span>
                      <span class="spectrogram spectro-b"></span>
                      <span class="spectrogram spectro-c"></span>
                      <i class="threshold-line"></i>
                      <span class="algorithm-readout readout-a">threshold</span>
                      <span class="algorithm-readout readout-b">open-set</span>
                    </div>
                    <div class="signal-console" aria-hidden="true">
                      <span style="--level: 84%;">keyword prototype</span>
                      <span style="--level: 62%;">stream window</span>
                      <span style="--level: 31%;">unknown reject</span>
                    </div>
                    <dl class="visual-metrics">
                      <div><dt>3-5</dt><dd>samples</dd></div>
                      <div><dt>gate</dt><dd>threshold</dd></div>
                      <div><dt>cool</dt><dd>down state</dd></div>
                    </dl>
                  </>
                )}

                {project.id === "waste" && (
                  <>
                    <div class="visual-waste visual-waste-lab" aria-hidden="true">
                      <span class="algorithm-kicker">classify.route.export</span>
                      <span class="camera-frame"></span>
                      <span class="bin"></span>
                      <span class="sort-line"></span>
                      <span class="label label-a"><span data-copy="en">paper</span><span data-copy="vi">giấy</span></span>
                      <span class="label label-b"><span data-copy="en">metal</span><span data-copy="vi">kim loại</span></span>
                      <span class="label label-c"><span data-copy="en">plastic</span><span data-copy="vi">nhựa</span></span>
                      <div class="confidence-stack">
                        <span style="--confidence: 82%;">organic</span>
                        <span style="--confidence: 58%;">plastic</span>
                        <span style="--confidence: 34%;">paper</span>
                      </div>
                      <span class="algorithm-readout readout-a">MobileNetV2</span>
                      <span class="algorithm-readout readout-b">TFLite</span>
                    </div>
                    <dl class="visual-metrics">
                      <div><dt>10</dt><dd>classes</dd></div>
                      <div><dt>top-k</dt><dd>confidence</dd></div>
                      <div><dt>edge</dt><dd>TFLite path</dd></div>
                    </dl>
                  </>
                )}
              </div>
            </div>
            <div class="story-content">
              <p class="project-type">
                <span data-copy="en">{project.type}</span>
                <span data-copy="vi">{project.viType}</span>
              </p>
              <h3>
                <span data-copy="en">{project.title}</span>
                <span data-copy="vi">{project.viTitle}</span>
              </h3>
              <dl class="story-grid">
                <div>
                  <dt><span data-copy="en">Problem</span><span data-copy="vi">Vấn đề</span></dt>
                  <dd><span data-copy="en">{project.problem}</span><span data-copy="vi">{project.viProblem}</span></dd>
                </div>
                <div>
                  <dt><span data-copy="en">Approach</span><span data-copy="vi">Cách làm</span></dt>
                  <dd><span data-copy="en">{project.approach}</span><span data-copy="vi">{project.viApproach}</span></dd>
                </div>
                <div>
                  <dt><span data-copy="en">Evidence</span><span data-copy="vi">Bằng chứng</span></dt>
                  <dd><span data-copy="en">{project.evidence}</span><span data-copy="vi">{project.viEvidence}</span></dd>
                </div>
              </dl>
              <section class="algorithm-panel" aria-label={`${project.title} algorithm pipeline`} data-algorithm-panel>
                <div class="algorithm-panel-head">
                  <span class="algorithm-label">
                    <span data-copy="en">Algorithm system</span>
                    <span data-copy="vi">Hệ thống thuật toán</span>
                  </span>
                  <strong>
                    <span data-copy="en">{project.signals.headline}</span>
                    <span data-copy="vi">{project.signals.viHeadline}</span>
                  </strong>
                </div>
                <ol class="algorithm-flow">
                  {project.algorithmFlow.map((step, stepIndex) => (
                    <li data-algorithm-step={step.key} style={`--step-index: ${stepIndex};`}>
                      <span class="flow-node">0{stepIndex + 1}</span>
                      <div>
                        <span class="flow-label">
                          <span data-copy="en">{step.label}</span>
                          <span data-copy="vi">{step.viLabel}</span>
                        </span>
                        <strong>
                          <span data-copy="en">{step.algorithm}</span>
                          <span data-copy="vi">{step.viAlgorithm}</span>
                        </strong>
                        <p>
                          <span data-copy="en">{step.detail}</span>
                          <span data-copy="vi">{step.viDetail}</span>
                        </p>
                      </div>
                    </li>
                  ))}
                </ol>
                <div class="algorithm-ledger drag-rail" data-drag-scroll>
                  <span>
                    <span data-copy="en">{project.signals.complexity}</span>
                    <span data-copy="vi">{project.signals.viComplexity}</span>
                  </span>
                  {project.signals.evidence.map((item, itemIndex) => (
                    <span>
                      <span data-copy="en">{item}</span>
                      <span data-copy="vi">{project.signals.viEvidence[itemIndex]}</span>
                    </span>
                  ))}
                </div>
              </section>
              <div class="stack-tags drag-rail" data-drag-scroll>
                {project.stack.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="story-actions">
                <a class="story-link" href={project.repo} target="_blank" rel="me noreferrer">
                  <ExternalLink size={15} aria-hidden="true" />
                  <span data-copy="en">Repository</span>
                  <span data-copy="vi">Repository</span>
                </a>
                {project.demo ? (
                  <a class="story-link" href={project.demo} target="_blank" rel="noreferrer">
                    <Play size={15} aria-hidden="true" />
                    <span data-copy="en">Demo</span>
                    <span data-copy="vi">Demo</span>
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section stack-section" id="stack">
      <div class="section-header" data-reveal>
        <p class="eyebrow">
          <span data-copy="en">Technical stack</span>
          <span data-copy="vi">Kỹ năng kỹ thuật</span>
        </p>
        <h2>
          <span data-copy="en">ML systems map from model to inference evidence.</span>
          <span data-copy="vi">Bản đồ hệ thống ML từ model đến bằng chứng inference.</span>
        </h2>
      </div>
      <div class="stack-lab" data-reveal>
        <div class="stack-core" aria-hidden="true">
          <span class="stack-ring ring-one"></span>
          <span class="stack-ring ring-two"></span>
          <span class="stack-ring ring-three"></span>
          <span class="stack-pulse"></span>
          <strong>ML</strong>
          <em>CV</em>
        </div>
        <div class="capability-grid capability-orbit">
          {capabilityGroups.map((item, index) => (
            <article data-reveal>
              <span class="capability-index">
                <span data-copy="en">Layer</span>
                <span data-copy="vi">Tầng</span>
                {" "}0{index + 1}
              </span>
              <h3><span data-copy="en">{item.title}</span><span data-copy="vi">{item.viTitle}</span></h3>
              <p><span data-copy="en">{item.text}</span><span data-copy="vi">{item.vi}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section proof-section" id="proof">
      <div class="section-header" data-reveal>
        <p class="eyebrow">
          <span data-copy="en">Recruiter proof</span>
          <span data-copy="vi">Bằng chứng cho recruiter</span>
        </p>
        <h2>
          <span data-copy="en">An evidence ledger for fast technical review.</span>
          <span data-copy="vi">Evidence ledger để recruiter review kỹ thuật nhanh.</span>
        </h2>
      </div>
      <div class="proof-grid proof-chain">
        {proofCards.map((card, index) => {
          const Icon = card.icon;
          return (
            <article data-reveal>
              <span class="proof-step">0{index + 1}</span>
              <Icon size={22} aria-hidden="true" />
              <h3><span data-copy="en">{card.title}</span><span data-copy="vi">{card.viTitle}</span></h3>
              <p><span data-copy="en">{card.text}</span><span data-copy="vi">{card.viText}</span></p>
            </article>
          );
        })}
      </div>
      <div class="proof-ledger drag-rail" data-reveal data-drag-scroll>
        <span><span data-copy="en">Source-first</span><span data-copy="vi">Ưu tiên nguồn gốc</span></span>
        <span><span data-copy="en">Repo-backed</span><span data-copy="vi">Có repo kiểm tra</span></span>
        <span><span data-copy="en">Demo-visible</span><span data-copy="vi">Có demo để xem</span></span>
      </div>
    </section>

    <section class="section profile-section" id="profile">
      <div class="profile-console" data-reveal>
        <div class="profile-summary">
          <p class="eyebrow"><span data-copy="en">Profile</span><span data-copy="vi">Hồ sơ</span></p>
          <h2>
            <span data-copy="en">ICT student preparing for AI/ML internship roles.</span>
            <span data-copy="vi">Sinh viên ICT hướng tới vai trò AI/ML Intern.</span>
          </h2>
          <p>
            <span data-copy="en">
              I prefer practical ML work: define a target, train and evaluate the model, ship a runnable demo,
              then document the workflow so others can reproduce it.
            </span>
            <span data-copy="vi">
              Tôi phù hợp với công việc ML thực tế: xác định mục tiêu, train và đánh giá model,
              làm demo chạy được, rồi viết tài liệu để người khác có thể tái lập.
            </span>
          </p>
        </div>
        <div class="profile-focus" aria-label="Focus areas">
          <span><span data-copy="en">Learning mode</span><span data-copy="vi">Chế độ học</span></span>
          <strong><span data-copy="en">Build, measure, explain</span><span data-copy="vi">Làm, đo, giải thích</span></strong>
          <small><span data-copy="en">Current direction: production-minded ML demos.</span><span data-copy="vi">Định hướng hiện tại: demo ML có tư duy triển khai.</span></small>
        </div>
      </div>
      <div class="timeline trajectory-timeline">
        {timeline.map((item, index) => (
          <article class="timeline-item" data-reveal>
            <span class="timeline-node" aria-hidden="true">0{index + 1}</span>
            <time>{item.period}</time>
            <div>
              <h3><span data-copy="en">{item.title}</span><span data-copy="vi">{item.viTitle}</span></h3>
              <p><span data-copy="en">{item.text}</span><span data-copy="vi">{item.viText}</span></p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-band" id="contact" data-reveal>
      <div>
        <p class="eyebrow"><span data-copy="en">Contact</span><span data-copy="vi">Liên hệ</span></p>
        <h2>
          <span data-copy="en">Open to AI/ML internship roles.</span>
          <span data-copy="vi">Sẵn sàng cho cơ hội AI/ML internship.</span>
        </h2>
        <p>
          <span data-copy="en">For internships, applied ML projects, or computer vision collaboration, contact me by email or LinkedIn.</span>
          <span data-copy="vi">Liên hệ qua email hoặc LinkedIn cho internship, project applied ML hoặc hợp tác computer vision.</span>
        </p>
      </div>
      <div class="contact-status" aria-label="Availability">
        <span class="status-dot" aria-hidden="true"></span>
        <strong><span data-copy="en">Available for internship review</span><span data-copy="vi">Sẵn sàng để recruiter xem hồ sơ</span></strong>
        <small><span data-copy="en">Best fit: AI/ML, Computer Vision, Python workflows.</span><span data-copy="vi">Phù hợp nhất: AI/ML, Computer Vision, workflow Python.</span></small>
      </div>
      <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${profile.email}`} data-magnetic>
          <Mail size={16} aria-hidden="true" />
          Email
        </a>
        <a class="button button-secondary" href={profile.cv} target="_blank" rel="noreferrer" data-magnetic>
          <FileDown size={16} aria-hidden="true" />
          CV
        </a>
        <a class="button button-secondary" href={profile.github} target="_blank" rel="me noreferrer" data-magnetic>
          <ExternalLink size={16} aria-hidden="true" />
          GitHub
        </a>
        <a class="button button-secondary" href={profile.linkedin} target="_blank" rel="me noreferrer" data-magnetic>
          <ExternalLink size={16} aria-hidden="true" />
          LinkedIn
        </a>
      </div>
    </section>
  </main>

  <nav class="mobile-command-dock" aria-label="Mobile quick actions">
    <a href="#work">
      <Rocket size={15} aria-hidden="true" />
      <span data-copy="en">Work</span>
      <span data-copy="vi">Dự án</span>
    </a>
    <a href={profile.cv} target="_blank" rel="noreferrer">
      <FileDown size={15} aria-hidden="true" />
      <span data-copy="en">CV</span>
      <span data-copy="vi">CV</span>
    </a>
    <a href="#contact">
      <Mail size={15} aria-hidden="true" />
      <span data-copy="en">Contact</span>
      <span data-copy="vi">Liên hệ</span>
    </a>
    <a href={profile.github} target="_blank" rel="me noreferrer">
      <ExternalLink size={15} aria-hidden="true" />
      GitHub
    </a>
  </nav>

  <footer class="site-footer">
    <p>
      &copy; 2026 {profile.name}. <span data-copy="en">All rights reserved.</span><span data-copy="vi">Mọi quyền được bảo lưu.</span>
    </p>
    <a href="#top"><span data-copy="en">Back to top</span><span data-copy="vi">Lên đầu trang</span></a>
  </footer>
</BaseLayout>
