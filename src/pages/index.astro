---
import { ExternalLink, FileDown, GitBranch, Mail, Play, Rocket, ShieldCheck } from "lucide-react";
import GlobalInteractions from "../components/GlobalInteractions";
import HeroScene from "../components/HeroScene";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilityGroups, profile, projects, proofSignals, timeline } from "../data/portfolio";

const title = "Phạm Hoàng An | AI/ML Portfolio";
const description =
  "AI/ML portfolio for Phạm Hoàng An, focused on computer vision, YOLO pipelines, keyword spotting, and applied ML systems.";

const signalBand = [
  {
    heading: "ML workflows",
    viHeading: "Workflow ML",
    text: "Training, evaluation, inference, documentation",
    viText: "Training, evaluation, inference, tài liệu",
  },
  {
    heading: "Computer vision",
    viHeading: "Computer vision",
    text: "YOLO, OpenCV, keypoints, tracking, homography",
    viText: "YOLO, OpenCV, keypoints, tracking, homography",
  },
  {
    heading: "Deployment path",
    viHeading: "Hướng triển khai",
    text: "Colab, Linux CLI, Azure VM, Google Cloud, Git",
    viText: "Colab, Linux CLI, Azure VM, Google Cloud, Git",
  },
  {
    heading: "Evidence",
    viHeading: "Bằng chứng",
    text: "Repos, runbooks, metrics, demos",
    viText: "Repo, runbook, metric, demo",
  },
];

const proofCards = [
  {
    icon: ShieldCheck,
    title: "Focused positioning",
    viTitle: "Định vị rõ ràng",
    text: "AI/ML and Computer Vision are the primary message across the site and GitHub profile.",
    viText: "AI/ML và Computer Vision là thông điệp chính trên website và GitHub profile.",
  },
  {
    icon: GitBranch,
    title: "GitHub readiness",
    viTitle: "GitHub sẵn sàng để xem",
    text: "Repo links, project summaries, and pinned repo guidance are prepared for quick review.",
    viText: "Link repo, tóm tắt dự án và gợi ý pin repo đã được chuẩn bị để recruiter xem nhanh.",
  },
  {
    icon: FileDown,
    title: "Recruiter package",
    viTitle: "Bộ thông tin cho recruiter",
    text: "CV, LinkedIn, email, and selected repos are one click away. Phone number stays private.",
    viText: "CV, LinkedIn, email và các repo chọn lọc đều truy cập nhanh. Số điện thoại không hiển thị công khai.",
  },
];
---

<BaseLayout title={title} description={description}>
  <GlobalInteractions client:load />

  <header class="site-header" data-site-header>
    <a class="brand" href="#top" aria-label="Go to top">
      <span class="brand-mark">PA</span>
      <span>{profile.name}</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list" id="site-menu" data-nav-list>
        <li><a href="#work"><span data-copy="en">Work</span><span data-copy="vi">Dự án</span></a></li>
        <li><a href="#stack"><span data-copy="en">Stack</span><span data-copy="vi">Kỹ năng</span></a></li>
        <li><a href="#proof"><span data-copy="en">Proof</span><span data-copy="vi">Bằng chứng</span></a></li>
        <li><a href="#profile"><span data-copy="en">Profile</span><span data-copy="vi">Hồ sơ</span></a></li>
        <li><a href="#contact"><span data-copy="en">Contact</span><span data-copy="vi">Liên hệ</span></a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="language-toggle" type="button" aria-pressed="false" aria-label="Switch to Vietnamese" data-language-toggle>
        <span data-copy="en">VI</span>
        <span data-copy="vi">EN</span>
      </button>
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-label="Open menu"
        aria-controls="site-menu"
        data-menu-button
      >
        <span></span>
        <span></span>
        <span></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section class="hero-shell" id="top">
      <HeroScene client:idle />
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow" data-intro>
            <span data-copy="en">AI/ML Intern · Computer Vision</span>
            <span data-copy="vi">AI/ML Intern · Computer Vision</span>
          </p>
          <h1 data-intro>
            <span>{profile.name}</span>
            <strong>
              <span data-copy="en">I build ML systems from model to working demo.</span>
              <span data-copy="vi">Tôi xây dựng hệ thống ML từ model đến demo chạy được.</span>
            </strong>
          </h1>
          <p class="hero-text" data-intro>
            <span data-copy="en">
              ICT student at USTH focused on computer vision, real-time inference, and reproducible Python workflows.
              My work connects training, evaluation, demos, and clear documentation.
            </span>
            <span data-copy="vi">
              Sinh viên ICT tại USTH, tập trung computer vision, inference thời gian thực và workflow Python có thể tái lập.
              Tôi kết nối training, evaluation, demo và tài liệu rõ ràng.
            </span>
          </p>

          <div class="hero-actions" aria-label="Primary actions" data-intro>
            <a class="button button-primary" href="#work" data-magnetic>
              <Rocket size={16} aria-hidden="true" />
              <span data-copy="en">View Work</span>
              <span data-copy="vi">Xem dự án</span>
            </a>
            <a class="button button-secondary" href={profile.cv} target="_blank" rel="noreferrer" data-magnetic>
              <FileDown size={16} aria-hidden="true" />
              <span data-copy="en">Download CV</span>
              <span data-copy="vi">Tải CV</span>
            </a>
            <a class="button button-ghost" href={profile.github} target="_blank" rel="me noreferrer" data-magnetic>
              <ExternalLink size={16} aria-hidden="true" />
              GitHub
            </a>
          </div>

          <div class="hero-chips" aria-hidden="true" data-intro>
            <span>YOLO</span>
            <span>OpenCV</span>
            <span><span data-copy="en">Real-time inference</span><span data-copy="vi">Inference thời gian thực</span></span>
            <span><span data-copy="en">Reproducible runs</span><span data-copy="vi">Chạy tái lập</span></span>
          </div>
        </div>

        <aside class="avatar-command" aria-label="Recruiter snapshot" data-intro>
          <div class="avatar-frame">
            <picture>
              <source type="image/webp" srcset={profile.portrait.webp} sizes="(max-width: 720px) 220px, (max-width: 1080px) 300px, 360px" />
              <img
                src={profile.portrait.fallback}
                width="720"
                height="1111"
                alt={`Portrait of ${profile.name}`}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <div class="avatar-meta">
            <p class="panel-kicker">
              <span data-copy="en">Snapshot</span>
              <span data-copy="vi">Tóm tắt</span>
            </p>
            <h2>{profile.name}</h2>
            <p>
              <span data-copy="en">{profile.role} - {profile.location}</span>
              <span data-copy="vi">{profile.viRole} - {profile.viLocation}</span>
            </p>
          </div>
          <dl class="signal-grid">
            {proofSignals.slice(0, 3).map((signal) => (
              <div class="signal-tile">
                <dt data-count={Number.isNaN(Number.parseInt(signal.value, 10)) ? undefined : signal.value}>{signal.value}</dt>
                <dd><span data-copy="en">{signal.label}</span><span data-copy="vi">{signal.vi}</span></dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class="signal-band" aria-label="Verification signals" data-reveal>
      {signalBand.map((item) => (
        <article>
          <strong><span data-copy="en">{item.heading}</span><span data-copy="vi">{item.viHeading}</span></strong>
          <span><span data-copy="en">{item.text}</span><span data-copy="vi">{item.viText}</span></span>
        </article>
      ))}
    </section>

    <section class="section work-section" id="work">
      <div class="section-header" data-reveal>
        <p class="eyebrow">
          <span data-copy="en">Selected work</span>
          <span data-copy="vi">Dự án chọn lọc</span>
        </p>
        <h2>
          <span data-copy="en">Case studies with clear problem, approach, and evidence.</span>
          <span data-copy="vi">Case study có vấn đề, cách làm và bằng chứng rõ ràng.</span>
        </h2>
      </div>

      <div class="project-stack">
        {projects.map((project, index) => (
          <article class={`project-story project-${project.id}`} data-project-id={project.id}>
            <div class="story-index" aria-hidden="true">0{index + 1}</div>
            <div class="story-visual" aria-hidden="true">
              {project.id === "pickleball" && (
                <div class="visual-pickle">
                  <span class="court-line line-a"></span>
                  <span class="court-line line-b"></span>
                  <span class="player-dot dot-a"></span>
                  <span class="player-dot dot-b"></span>
                  <span class="ball-path"></span>
                  <span class="heat-zone"></span>
                </div>
              )}
              {project.id === "kws" && (
                <div class="visual-audio">
                  <span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
              )}
              {project.id === "waste" && (
                <div class="visual-waste">
                  <span class="bin"></span>
                  <span class="sort-line"></span>
                  <span class="label label-a"><span data-copy="en">paper</span><span data-copy="vi">giấy</span></span>
                  <span class="label label-b"><span data-copy="en">metal</span><span data-copy="vi">kim loại</span></span>
                  <span class="label label-c"><span data-copy="en">plastic</span><span data-copy="vi">nhựa</span></span>
                </div>
              )}
            </div>
            <div class="story-content">
              <p class="project-type">
                <span data-copy="en">{project.type}</span>
                <span data-copy="vi">{project.viType}</span>
              </p>
              <h3>
                <span data-copy="en">{project.title}</span>
                <span data-copy="vi">{project.viTitle}</span>
              </h3>
              <dl class="story-grid">
                <div>
                  <dt><span data-copy="en">Problem</span><span data-copy="vi">Vấn đề</span></dt>
                  <dd><span data-copy="en">{project.problem}</span><span data-copy="vi">{project.viProblem}</span></dd>
                </div>
                <div>
                  <dt><span data-copy="en">Approach</span><span data-copy="vi">Cách làm</span></dt>
                  <dd><span data-copy="en">{project.approach}</span><span data-copy="vi">{project.viApproach}</span></dd>
                </div>
                <div>
                  <dt><span data-copy="en">Evidence</span><span data-copy="vi">Bằng chứng</span></dt>
                  <dd><span data-copy="en">{project.evidence}</span><span data-copy="vi">{project.viEvidence}</span></dd>
                </div>
              </dl>
              <div class="stack-tags">
                {project.stack.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="story-actions">
                <a class="story-link" href={project.repo} target="_blank" rel="me noreferrer">
                  <ExternalLink size={15} aria-hidden="true" />
                  <span data-copy="en">Repository</span>
                  <span data-copy="vi">Repository</span>
                </a>
                {project.demo ? (
                  <a class="story-link" href={project.demo} target="_blank" rel="noreferrer">
                    <Play size={15} aria-hidden="true" />
                    <span data-copy="en">Demo</span>
                    <span data-copy="vi">Demo</span>
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section stack-section" id="stack">
      <div class="section-header" data-reveal>
        <p class="eyebrow">
          <span data-copy="en">Technical stack</span>
          <span data-copy="vi">Kỹ năng kỹ thuật</span>
        </p>
        <h2>
          <span data-copy="en">Focused tools for applied ML and computer vision.</span>
          <span data-copy="vi">Bộ công cụ gọn cho applied ML và computer vision.</span>
        </h2>
      </div>
      <div class="capability-grid">
        {capabilityGroups.map((item, index) => (
          <article data-reveal>
            <span class="capability-index">0{index + 1}</span>
            <h3><span data-copy="en">{item.title}</span><span data-copy="vi">{item.viTitle}</span></h3>
            <p><span data-copy="en">{item.text}</span><span data-copy="vi">{item.vi}</span></p>
          </article>
        ))}
      </div>
    </section>

    <section class="section proof-section" id="proof">
      <div class="section-header" data-reveal>
        <p class="eyebrow">
          <span data-copy="en">Recruiter proof</span>
          <span data-copy="vi">Bằng chứng cho recruiter</span>
        </p>
        <h2>
          <span data-copy="en">A short path from profile to technical evidence.</span>
          <span data-copy="vi">Đường dẫn ngắn từ hồ sơ đến bằng chứng kỹ thuật.</span>
        </h2>
      </div>
      <div class="proof-grid">
        {proofCards.map((card) => {
          const Icon = card.icon;
          return (
            <article data-reveal>
              <Icon size={22} aria-hidden="true" />
              <h3><span data-copy="en">{card.title}</span><span data-copy="vi">{card.viTitle}</span></h3>
              <p><span data-copy="en">{card.text}</span><span data-copy="vi">{card.viText}</span></p>
            </article>
          );
        })}
      </div>
    </section>

    <section class="section profile-section" id="profile">
      <div class="profile-summary" data-reveal>
        <p class="eyebrow"><span data-copy="en">Profile</span><span data-copy="vi">Hồ sơ</span></p>
        <h2>
          <span data-copy="en">ICT student preparing for AI/ML internship roles.</span>
          <span data-copy="vi">Sinh viên ICT hướng tới vai trò AI/ML Intern.</span>
        </h2>
        <p>
          <span data-copy="en">
            I prefer practical ML work: define a target, train and evaluate the model, ship a runnable demo,
            then document the workflow so others can reproduce it.
          </span>
          <span data-copy="vi">
            Tôi phù hợp với công việc ML thực tế: xác định mục tiêu, train và đánh giá model,
            làm demo chạy được, rồi viết tài liệu để người khác có thể tái lập.
          </span>
        </p>
      </div>
      <div class="timeline">
        {timeline.map((item) => (
          <article class="timeline-item" data-reveal>
            <time>{item.period}</time>
            <div>
              <h3><span data-copy="en">{item.title}</span><span data-copy="vi">{item.viTitle}</span></h3>
              <p><span data-copy="en">{item.text}</span><span data-copy="vi">{item.viText}</span></p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-band" id="contact" data-reveal>
      <div>
        <p class="eyebrow"><span data-copy="en">Contact</span><span data-copy="vi">Liên hệ</span></p>
        <h2>
          <span data-copy="en">Open to AI/ML internship roles.</span>
          <span data-copy="vi">Sẵn sàng cho cơ hội AI/ML internship.</span>
        </h2>
        <p>
          <span data-copy="en">For internships, applied ML projects, or computer vision collaboration, contact me by email or LinkedIn.</span>
          <span data-copy="vi">Liên hệ qua email hoặc LinkedIn cho internship, project applied ML hoặc hợp tác computer vision.</span>
        </p>
      </div>
      <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${profile.email}`} data-magnetic>
          <Mail size={16} aria-hidden="true" />
          Email
        </a>
        <a class="button button-secondary" href={profile.cv} target="_blank" rel="noreferrer" data-magnetic>
          <FileDown size={16} aria-hidden="true" />
          CV
        </a>
        <a class="button button-secondary" href={profile.github} target="_blank" rel="me noreferrer" data-magnetic>
          <ExternalLink size={16} aria-hidden="true" />
          GitHub
        </a>
        <a class="button button-secondary" href={profile.linkedin} target="_blank" rel="me noreferrer" data-magnetic>
          <ExternalLink size={16} aria-hidden="true" />
          LinkedIn
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>
      &copy; 2026 {profile.name}. <span data-copy="en">All rights reserved.</span><span data-copy="vi">Mọi quyền được bảo lưu.</span>
    </p>
    <a href="#top"><span data-copy="en">Back to top</span><span data-copy="vi">Lên đầu trang</span></a>
  </footer>
</BaseLayout>
